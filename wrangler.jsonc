{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "slopscore",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "observability": { "enabled": true },
  "rules": [{ "type": "Text", "globs": ["**/*.svg", "**/*.txt"], "fallthrough": true }],
  // Top level = local dev (`wrangler dev`). Deploy with `--env test` or `--env production`.
  "d1_databases": [
    { "binding": "DB", "database_name": "slopscore", "database_id": "a93167e0-ce88-4697-b92b-748d39084c70", "migrations_dir": "migrations" }
  ],
  "ai": { "binding": "AI", "remote": true },
  "triggers": { "crons": ["*/15 * * * *", "*/5 * * * *", "*/10 * * * *", "7 * * * *", "5 0 * * *"] },
  "vars": {
    "SITE_NAME": "SlopScore",
    "SITE_URL": "http://localhost:8787",
    // Local dev mirrors production so the indexing behaviour can be checked before it ships.
    "TRAWL_INDEX": "on",
    // A handle is a person. Repo pages follow TRAWL_INDEX; /u/{login} for somebody who never opted
    // in answers to this one, and it stays off. Opting in on any repo indexes that owner regardless.
    "TRAWL_OWNER_INDEX": "off",
    "PLAN_MODE": "free",
    "CONTACT_EMAIL": "hello@slopscore.org",
    "ABUSE_EMAIL": "abuse@slopscore.org",
    "ADMIN_LOGINS": "NTBooks",
    "MIN_ACCOUNT_AGE_DAYS": "30",
    "AUTO_HIDE_REPORTS": "3",
    "AI_NEURON_BUDGET": "9000",
    "RISK_QUARANTINE": "40",
    "MOD_FLAGS": "all,-rising,-controversial,-updated,-upcoming",
    "CRITICS_MODEL": "anthropic/claude-haiku-4.5",
    "TRAWL_PER_DAY": "50",
    "TRAWL_STOP_AT": "300",
    "TAKEDOWN_AUTO_PER_DAY": "20",
    // Where the weekly bulletin is mailed from. A newsletter somebody else operates, so the site keeps no
    // mailing list and never stores a reader's address. Unset = no subscribe link; /report and /report.xml
    // carry on regardless. Set it in test and production when the publication's name is settled.
    "NEWSLETTER_URL": "https://slopscore.substack.com",
    "NEWSLETTER_NAME": "SlopScore on Substack",
    // IndexNow: public by design, served at /{key}.txt so Bing, Yandex and Seznam can verify the host.
    "INDEXNOW_KEY": "f5d98c829cad74d917062e34ed1ec0a6"
  },
  "env": {
    "test": {
      "name": "slopscore-test",
      "routes": [{ "pattern": "test.slopscore.org", "custom_domain": true }],
      "d1_databases": [
        { "binding": "DB", "database_name": "slopscore-test", "database_id": "65264eba-0c77-477d-b4b6-80bff9b6e032", "migrations_dir": "migrations" }
      ],
      "ai": { "binding": "AI" },
      "send_email": [{ "name": "MAIL" }],
      // The same five crons as production. The account is on Workers Paid (250 cron triggers), so the combined
      // half-hour tick that the free plan forced on this environment is gone, and test runs the real schedule.
      "triggers": { "crons": ["*/15 * * * *", "*/5 * * * *", "*/10 * * * *", "7 * * * *", "5 0 * * *"] },
      "vars": {
        "SITE_NAME": "SlopScore (test)",
        "SITE_URL": "https://test.slopscore.org",
        "PRIMARY_HOST": "test.slopscore.org",
        // Off here, on in production: this is a copy of the site with its own database, and it must never put
        // strangers' repos into search beside the real listings. robots.txt refuses crawlers on test hosts too.
        "TRAWL_INDEX": "off",
        // A handle is a person. Repo pages follow TRAWL_INDEX; /u/{login} for somebody who never opted
        // in answers to this one, and it stays off. Opting in on any repo indexes that owner regardless.
        "TRAWL_OWNER_INDEX": "off",
        "PLAN_MODE": "paid",
        "CONTACT_EMAIL": "hello@slopscore.org",
        "ABUSE_EMAIL": "abuse@slopscore.org",
        "ADMIN_LOGINS": "NTBooks",
        "MIN_ACCOUNT_AGE_DAYS": "30",
        "AUTO_HIDE_REPORTS": "3",
        // Lower than production's 9000 on purpose: test shares the account's Workers AI allowance and should
        // never be the reason production's free scans defer.
        "AI_NEURON_BUDGET": "2000",
        "RISK_QUARANTINE": "40",
        "MOD_FLAGS": "all,-rising,-controversial,-updated,-upcoming",
        "CRITICS_MODEL": "anthropic/claude-haiku-4.5",
        // Enough to exercise the lane, not enough to run a second trawl on the OpenRouter bill.
        "TRAWL_PER_DAY": "5",
        "TRAWL_STOP_AT": "300",
        "TAKEDOWN_AUTO_PER_DAY": "20",
        // Where the weekly bulletin is mailed from — a newsletter somebody else operates, so the site keeps
        // no mailing list and never stores a reader's address. Unset = no subscribe link, and /report plus
        // /report.xml carry on regardless. Deliberately NOT a custom domain: the copy must never compete
        // with slopscore.org/report, which is the citable original.
        "NEWSLETTER_URL": "https://slopscore.substack.com",
        "NEWSLETTER_NAME": "SlopScore on Substack",
        // IndexNow: public by design, served at /{key}.txt so Bing, Yandex and Seznam can verify the host.
        "INDEXNOW_KEY": "f5d98c829cad74d917062e34ed1ec0a6"
      }
    },
    "production": {
      "name": "slopscore",
      // slopscore.org is home. slopscupper.com is a marketing address: it answers and redirects here
      // (src/lib/host.ts), and it is listed so the worker owns the hostname rather than leaving it parked.
      // Deploy FAILS if a zone listed here is not in the Cloudflare account: drop a pattern if it is not added.
      "routes": [
        { "pattern": "slopscore.org", "custom_domain": true },
        { "pattern": "www.slopscore.org", "custom_domain": true },
        { "pattern": "slopscupper.com", "custom_domain": true },
        { "pattern": "www.slopscupper.com", "custom_domain": true }
      ],
      "d1_databases": [
        { "binding": "DB", "database_name": "slopscore", "database_id": "a93167e0-ce88-4697-b92b-748d39084c70", "migrations_dir": "migrations" }
      ],
      "ai": { "binding": "AI" },
      "send_email": [{ "name": "MAIL" }],
      "triggers": { "crons": ["*/15 * * * *", "*/5 * * * *", "*/10 * * * *", "7 * * * *", "5 0 * * *"] },
      "vars": {
        "SITE_NAME": "SlopScore",
        "SITE_URL": "https://slopscore.org",
        // The one hostname every absolute URL we emit uses. Set to slopscupper.com to finish the move.
        "PRIMARY_HOST": "slopscore.org",
        // "on" lets trawled listings into search, the sitemap and IndexNow. These are public repos on a public
        // host whose owners said in public that a model wrote them, and the listing is commentary on that. It is
        // indexed the way every other mirror and aggregator indexes them, with a takedown that needs no account.
        // "off" keeps them readable, linkable and votable but invisible to search engines.
        "TRAWL_INDEX": "on",
        // A handle is a person. Repo pages follow TRAWL_INDEX; /u/{login} for somebody who never opted
        // in answers to this one, and it stays off. Opting in on any repo indexes that owner regardless.
        "TRAWL_OWNER_INDEX": "off",
        "PLAN_MODE": "paid",
        "CONTACT_EMAIL": "hello@slopscore.org",
        "ABUSE_EMAIL": "abuse@slopscore.org",
        "ADMIN_LOGINS": "NTBooks",
        "MIN_ACCOUNT_AGE_DAYS": "30",
        "AUTO_HIDE_REPORTS": "3",
        "AI_NEURON_BUDGET": "9000",
        "RISK_QUARANTINE": "40",
        "MOD_FLAGS": "all,-rising,-controversial,-updated,-upcoming",
        "CRITICS_MODEL": "anthropic/claude-haiku-4.5",
        "TRAWL_PER_DAY": "50",
        "TRAWL_STOP_AT": "300",
        "TAKEDOWN_AUTO_PER_DAY": "20",
        // Where the weekly bulletin is mailed from — a newsletter somebody else operates, so the site keeps
        // no mailing list and never stores a reader's address. Unset = no subscribe link, and /report plus
        // /report.xml carry on regardless. Deliberately NOT a custom domain: the copy must never compete
        // with slopscore.org/report, which is the citable original.
        "NEWSLETTER_URL": "https://slopscore.substack.com",
        "NEWSLETTER_NAME": "SlopScore on Substack",
        // IndexNow: public by design, served at /{key}.txt so Bing, Yandex and Seznam can verify the host.
        "INDEXNOW_KEY": "f5d98c829cad74d917062e34ed1ec0a6"
      }
    }
  }
}
