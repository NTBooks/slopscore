{
  "name": "slopscore",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SlopScore — peer review for code nobody wrote.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply slopscore --local",
    "db:migrate": "wrangler d1 migrations apply slopscore --remote",
    "db:seed:local": "node scripts/seed.mjs > .seed.sql && wrangler d1 execute slopscore --local --file .seed.sql",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.9.0",
    "yaml": "^2.8.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260910.1",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.131.0"
  }
}
